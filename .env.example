# KampusMarket — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK boleh di-commit ke repository (sudah ada di .gitignore).

# Supabase Project URL (contoh: https://xxxxxxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (bukan service_role key)
EXPO_PUBLIC_SUPABASE_KEY=
